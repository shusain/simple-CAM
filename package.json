{
  "name": "simple-cam",
  "version": "1.0.0",
  "description": "Desktop CAM sketcher for MPCNC / Marlin G-code generation",
  "main": "src/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "webpack serve --config webpack.config.js --mode development",
    "dev:electron": "wait-on tcp:3000 && cross-env ELECTRON_RENDERER_URL=http://localhost:3000 electron .",
    "build": "webpack --config webpack.config.js --mode production",
    "start": "npm run build && electron ."
  },
  "keywords": [
    "cam",
    "electron",
    "gcode",
    "marlin",
    "mpcnc"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "babel-loader": "^10.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "electron": "^42.4.0",
    "html-webpack-plugin": "^5.6.5",
    "style-loader": "^4.0.0",
    "wait-on": "^8.0.5",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.5"
  }
}
