{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-electron",
    "rootDir": "src",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/main.ts", "src/preload.ts", "src/types/**/*.ts", "src/types/**/*.d.ts"]
}
